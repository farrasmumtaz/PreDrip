{
  "name": "predrip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "security:test": "tsc -p tests/security/tsconfig.json && node --test .data-tools/security/tests/security/*.test.js",
    "security:test:web": "tsc -p tests/security/tsconfig.json && node --test .data-tools/security/tests/security/http.js",
    "data:build": "tsc -p research/tsconfig.json",
    "data:audit": "npm run data:build && node .data-tools/cli.js",
    "data:test": "npm run data:build && node --test .data-tools/audit.test.js",
    "data:test:web": "npm run data:build && node --test .data-tools/dataset-web.test.js",
    "weather:build": "tsc -p tests/weather/tsconfig.json",
    "weather:test": "npm run weather:build && node --test .data-tools/weather/tests/weather/bmkg.test.js",
    "weather:check": "npm run weather:build && node .data-tools/weather/tests/weather/live.js",
    "weather:test:web": "npm run weather:build && node --test .data-tools/weather/tests/weather/dashboard-web.test.js",
    "data:audit:example": "npm run data:audit -- --weather research/fixtures/weather.synthetic.csv --labels research/fixtures/labels.synthetic.csv --region kota-bandung --kind synthetic",
    "data:inspect:saca": "npm run data:build && node .data-tools/inspect-saca.js",
    "data:acquire:era5": "npm run data:build && node .data-tools/acquire-era5.js",
    "data:audit:pilot": "npm run data:audit -- --weather research/data/normalized/era5-kota-bandung-2015-01-01-2025-12-31.weather.csv --labels research/evidence/kota-bandung-positive-labels.csv --region kota-bandung --kind historical",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.9.0",
    "bcryptjs": "3.0.2",
    "leaflet": "^1.9.4",
    "next": "15.5.19",
    "prisma": "6.9.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "3.25.64"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.15.30",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "eslint": "9.28.0",
    "eslint-config-next": "15.5.19",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
